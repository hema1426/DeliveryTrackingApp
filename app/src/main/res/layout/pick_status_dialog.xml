<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:card_view="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/lightble1"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_5sdp"
        android:background="@color/colorPrimary"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="5dp"
                android:text="update Status "
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/invNo_pick_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="5dp"
                android:text=""
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:id="@+id/close_btn_failed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_gravity="center"
            android:layout_marginRight="10dp"
            android:padding="6sp"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="@color/white" />
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:padding="5dp"
            android:textStyle="bold"
            android:layout_margin="5dp"
            android:textColor="@color/pink_clr"
            android:text="Status :"
            android:textSize="13sp"
            />
        <Spinner
            android:id="@+id/spinner_status_update"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:background="@drawable/spinner_bg"
            android:layout_height="35dp"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:id="@+id/reasonLayl"
        android:visibility="gone"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:padding="5dp"
            android:textStyle="bold"
            android:layout_margin="5dp"
            android:textColor="@color/pink_clr"
            android:text="Reason :"
            android:textSize="13sp"
            />
        <EditText
            android:id="@+id/reason_picklist"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:layout_marginBottom="10dp"
            android:textSize="11sp"
            android:text=""
            android:paddingLeft="10dp"
            android:background="@drawable/layout_border_radious5_hash"
            />
    </LinearLayout>

    <Button
        android:id="@+id/failed_status_submit"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Submit"
        android:layout_marginTop="20dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="50dp"
        android:layout_gravity="right"
        android:gravity="center"
        android:layout_below="@+id/text_dialog"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:background="@drawable/new_border_red_clr"
        android:textColor="@color/colorPrimary" />


</LinearLayout>